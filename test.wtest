import jugador.*
import enemigo.*
import armas.*
import partida.*
import wollok.game.*

describe "Tests para Wollok Invaders" {

    // Creamos enemigos variados
    const enemigoLejos = new Enemigo(
        vida = 100,
        position = game.at(5, 12),
        imagen = "enemigoComun.png",
        debilidad = bala
    )

    const enemigoCerca = new Enemigo(
        vida = 100,
        position = game.at(5, 8),
        imagen = "enemigoFuerte.png",
        debilidad = cohete
    )

    const enemigoOtraColumna = new Enemigo(
        vida = 100,
        position = game.at(3, 8),
        imagen = "enemigoSuperFuerte.png",
        debilidad = laser
    )


    method initialize() {
        partida.enemigos().clear()
        partida.enemigos().addAll([
            enemigoLejos,
            enemigoCerca,
            enemigoOtraColumna
        ])

        naveJugador.position(game.at(5, 0))
        naveJugador.seleccionarArma(laser)
    }


    test "La nave del jugador respeta el limite derecho de la pantalla" {
        // Colocamos la nave en el extremo derecho
        naveJugador.position(game.at(7, 0))

        // Intentamos moverla una posición más hacia la derecha
        naveJugador.mover(movimientoDerecha)

        // La nave no debe salir del mapa
        assert.equals(7, naveJugador.position().x())
    }


    test "La nave impacta al enemigo mas cercano de su columna" {
        naveJugador.position(game.at(5, 0))
        naveJugador.seleccionarArma(bala)

        naveJugador.disparar(partida.enemigos())

        // enemigoCerca está en la misma columna y es el más cercano
        // bala no es su debilidad, por lo que recibe 50 de daño
        assert.equals(50, enemigoCerca.vida())

        // Los demás enemigos no deben recibir daño
        assert.equals(100, enemigoLejos.vida())
        assert.equals(100, enemigoOtraColumna.vida())
    }


    test "El daño critico se aplica cuando el arma coincide con la debilidad" {
        naveJugador.position(game.at(3, 0))
        naveJugador.seleccionarArma(laser)

        naveJugador.disparar(partida.enemigos())

        // laser es la debilidad de enemigoOtraColumna
        assert.equals(0, enemigoOtraColumna.vida())
    }


    test "El cambio de turno mueve correctamente a los enemigos" {
        const posicionInicialY = enemigoLejos.position().y()

        partida.turnoJugadorTerminado()

        // Los enemigos bajan una posición
        assert.equals(
            posicionInicialY - 1,
            enemigoLejos.position().y()
        )
    }
    
}
import wollok.game.*
import jugador.*
import partida.*
import arena.*
import enemigo.*
import pantallas.*

program juego {

    game.title("Wollok Invaders")

    //Configuracion del mapa
    game.width(8)
    game.height(16)
    game.cellSize(64)
    game.boardGround("fondo.png")

    //Generacion de enemigos
    partida.generarEnemigos()

    //Menu -> toco enter para empezar
    game.addVisual(menu)
    keyboard.enter().onPressDo{
        partida.iniciar()
    }

    //Movimiento de Enemigos por turno de jugador
    keyboard.space().onPressDo{
        partida.turnoJugadorTerminado()
    }

	naveJugador.configurarControles()

    game.start()
}
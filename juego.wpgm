import wollok.game.*
import jugador.*
import partida.*
import arena.*

program juego {

    game.title("Wollok Invaders")

    //Configuracion del mapa
    game.width(11)
    game.height(11)
    game.cellSize(50)
		
    game.addVisual(naveJugador)

	naveJugador.configurarControles()

    game.start()
}